# =========================================================
# Everidemy — Environment Configuration
# =========================================================
# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# NEVER commit your real `.env` file to version control.
# =========================================================


# ---------------------------------------------------------
# Flask / Core
# ---------------------------------------------------------

# Secret key used to sign session cookies & CSRF tokens.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to True only when serving over HTTPS (production).
SESSION_COOKIE_SECURE=False

# Max request body size in BYTES.
# Default in config.py: 16 MB. Examples:
#   16 * 1024 * 1024 = 16777216  (16 MB)
#   32 * 1024 * 1024 = 33554432  (32 MB)
MAX_CONTENT_LENGTH=16777216

# Force URL scheme for generated links. Leave empty for auto.
# Use "https" in production behind a TLS-terminating proxy.
PREFERRED_URL_SCHEME=

# Port the Flask dev server binds to (production PaaS platforms
# inject PORT dynamically — do not hardcode in a Dockerfile).
PORT=5003


# ---------------------------------------------------------
# Super Admin (bootstrap)
# ---------------------------------------------------------
# Created automatically on first boot if no super_admin exists.
# CHANGE THESE BEFORE DEPLOYING TO PRODUCTION.

SUPER_ADMIN_EMAIL=admin@everidemy.com
SUPER_ADMIN_PASSWORD=ChangeMe123!


# ---------------------------------------------------------
# MongoDB
# ---------------------------------------------------------

# Full MongoDB connection string.
# Local example:   mongodb://localhost:27017
# Atlas example:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Database name used by the application.
MONGO_DB_NAME=everidemy

# Ping Mongo at boot (fail fast on misconfiguration).
# Set to "false" only if you're behind a firewall and can't reach Mongo
# during deploy — the app will still boot but every request will 500.
MONGO_PING_ON_BOOT=true


# ---------------------------------------------------------
# Paystack
# ---------------------------------------------------------

# Get these from your Paystack dashboard:
#   https://dashboard.paystack.com/#/settings/developers
#
# ⚠️ Replace these placeholder values before deploying.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the Paystack API (usually no need to change).
PAYSTACK_BASE_URL=https://api.paystack.co


# ---------------------------------------------------------
# Platform Subscription (single monthly plan)
# ---------------------------------------------------------
# NOTE: There is NO plan code. Every month is a fresh
#       one-time charge, not a Paystack subscription.

# Amount in the MAJOR currency unit (GHS, NOT pesewas).
# The code multiplies by 500 before sending to Paystack.
# Example: 500 = GH₵ 500.00
PAYSTACK_PLATFORM_AMOUNT=500

# ISO 4217 currency code. Supported: GHS, NGN, ZAR, KES, USD.
PAYSTACK_PLATFORM_CURRENCY=GHS

# No trial, no grace — schools are locked until they pay.
# Leave both at 0 unless you intentionally want to change that.
TRIAL_DAYS=0
PAYSTACK_GRACE_DAYS=0


# ---------------------------------------------------------
# Platform Branding
# ---------------------------------------------------------

PLATFORM_NAME=Everidemy

# Currency used for school invoices + payments.
PLATFORM_CURRENCY=GHS
PLATFORM_CURRENCY_SYMBOL=GH₵


# ---------------------------------------------------------
# Email — Resend (https://resend.com)
# ---------------------------------------------------------
# Resend is a transactional email API. Get your API key at:
#   https://resend.com/api-keys
#
# Verify your sending domain at:
#   https://resend.com/domains
#
# ⚠️ Replace the placeholder key before deploying.

RESEND_API_KEY=re_xxxxxxxxx

# From-address shown to recipients. Must be a verified
# domain in your Resend account, otherwise delivery fails.
RESEND_FROM_EMAIL=Everidemy <noreply@everidemy.com>

# Display name only (optional; used if RESEND_FROM_EMAIL doesn't
# already include a display name).
RESEND_FROM_NAME=Everidemy


# ---------------------------------------------------------
# SMS — Arkesel (https://arkesel.com)
# ---------------------------------------------------------
# Arkesel is a Ghana-based SMS gateway. Get your API key at:
#   https://sms.arkesel.com/dashboard
#
# ⚠️ Replace the placeholder key before deploying.

ARKESEL_API_KEY=your-arkesel-api-key

# 11-character alphanumeric sender ID. Must be approved by Arkesel
# for your account, otherwise messages fall back to a shared short code.
ARKESEL_SENDER_ID=Everidemy

# Base URL for the Arkesel API v2 (usually no need to change).
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2